generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SocialPlatform {
  INSTAGRAM
  YOUTUBE
  TIKTOK
  X
  FACEBOOK
  OTHER
}

enum DeviceType {
  IOS
  ANDROID
  DESKTOP
  OTHER
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Influencer {
  id           String         @id @default(cuid())
  name         String
  handle       String?
  email        String?
  platform     SocialPlatform @default(INSTAGRAM)
  followers    Int?
  notes        String?
  /// Code users enter at signup in the referral portal, e.g. "BHARANI". Stored uppercase.
  referralCode String         @unique
  /// Campaign period agreed with the influencer (inclusive dates).
  periodStart  DateTime?      @db.Date
  periodEnd    DateTime?      @db.Date
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  link         Link?
  signupCounts SignupCount[]
  coupons      Coupon[]

  @@index([createdAt])
}

/// The influencer's tracking link: /r/{code} -> DOWNLOAD_URL
model Link {
  id           String   @id @default(cuid())
  code         String   @unique
  influencerId String   @unique
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  influencer Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  clicks     Click[]
}

/// Link names used before (influencer deleted or link renamed). They are never given to anyone else.
model RetiredCode {
  code           String   @id
  /// Who used it. Kept after deletion so the original influencer can take it back if renamed.
  influencerId   String?
  influencerName String
  retiredAt      DateTime @default(now())
}

/// Referral signups for one influencer on one day, copied from the referral portal.
model SignupCount {
  id           String   @id @default(cuid())
  influencerId String
  /// The day the signups happened.
  date         DateTime @db.Date
  count        Int
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  influencer Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)

  @@unique([influencerId, date])
  @@index([date])
}

model Click {
  id        String     @id @default(cuid())
  linkId    String
  createdAt DateTime   @default(now())
  device    DeviceType
  os        String?
  browser   String?
  country   String?
  referrer  String?
  /// Salted hash of IP + user agent, used for unique-visitor counts.
  visitorId String
  isBot     Boolean    @default(false)

  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId, createdAt])
  @@index([createdAt])
}

model Coupon {
  id              String       @id @default(cuid())
  code            String       @unique
  description     String?
  discountType    DiscountType @default(PERCENTAGE)
  discountValue   Decimal      @db.Decimal(10, 2)
  /// Optional minimum order amount for the coupon to apply.
  minOrderAmount  Decimal?     @db.Decimal(10, 2)
  /// Total redemptions allowed across all users (null = unlimited).
  maxRedemptions  Int?
  /// Redemptions allowed per user (null = unlimited).
  perUserLimit    Int?
  redemptionCount Int          @default(0)
  startsAt        DateTime?
  expiresAt       DateTime?
  isActive        Boolean      @default(true)
  influencerId    String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  influencer  Influencer?        @relation(fields: [influencerId], references: [id], onDelete: SetNull)
  redemptions CouponRedemption[]

  @@index([influencerId])
}

model CouponRedemption {
  id              String   @id @default(cuid())
  couponId        String
  /// The user's id in your app.
  userId          String
  orderId         String?
  orderAmount     Decimal? @db.Decimal(10, 2)
  discountApplied Decimal  @db.Decimal(10, 2)
  createdAt       DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([couponId, orderId])
  @@index([couponId, userId])
}

/// Links for partner posts (e.g. Tamada Media on LinkedIn): /go/{slug} -> destinationUrl.
/// Kept apart from influencers: their clicks never show up in the influencer dashboard.
model PartnerLink {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  /// Where the post is shared, e.g. "LinkedIn".
  channel        String
  destinationUrl String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  clicks PartnerClick[]
}

model PartnerClick {
  id        String     @id @default(cuid())
  linkId    String
  createdAt DateTime   @default(now())
  device    DeviceType
  os        String?
  browser   String?
  country   String?
  referrer  String?
  /// Salted hash of IP + user agent, used for unique-visitor counts.
  visitorId String
  isBot     Boolean    @default(false)

  link PartnerLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId, createdAt])
}
